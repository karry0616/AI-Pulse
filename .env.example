# ============================================
# AI Pulse · 环境变量模板
# 用法：复制本文件为 .env，填入真实值后保存，再到页面点一次 Rerun
# 注意：.env 含密钥，不要提交到 Git
# ============================================

# DeepSeek API Key（必填，用于 Collector / Analyst 的结构化提取）
# 获取地址：https://platform.deepseek.com/api_keys
# 格式：sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=

# 预警推送 Webhook（可选；留空时预警只在页面暂存，不推送）
# 飞书群机器人：https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx
# 钉钉群机器人：https://oapi.dingtalk.com/robot/send?access_token=xxxxxxxx
WEBHOOK_URL=

# 钉钉机器人「加签」密钥（安全设置选「加签」时才需要，SEC 开头）
# 选「自定义关键词」的话留空即可，关键词建议填：预警
DINGTALK_SECRET=
